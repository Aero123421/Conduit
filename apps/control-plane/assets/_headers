/setup
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: publickey-credentials-create=(self), publickey-credentials-get=(self)
/login
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: publickey-credentials-get=(self)
/device
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'
  Permissions-Policy: publickey-credentials-get=(self)
/dashboard
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self' wss:; form-action 'self'; frame-ancestors 'none'
/static/*
  Cache-Control: public, max-age=604800, immutable
  Content-Security-Policy: default-src 'none'

    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.7.2",
    "vitest": "2.1.9"
  }
}

# Optional systemd EnvironmentFile for conduit-node.service.
# Copy this file to ~/.config/conduit/node.env, replace every example path,
# and keep it mode 0600. The service defaults already follow the XDG layout.
# Values use systemd EnvironmentFile syntax, not TOML or shell syntax.

CONDUIT_DATA_DIR=/home/example/.local/share/conduit
CONDUIT_SOCKET=/run/user/1000/conduit/node.sock
CONDUIT_LAUNCH_PROFILES=/home/example/.config/conduit/launch-profiles.json

# Remote transport is enabled only when both values are set. The URL must be
# wss:// and the Device ID must be the exact enrolled Device identifier.
# CONDUIT_CONTROL_URL=wss://conduit.example.com/api/v1/node/connect
# CONDUIT_DEVICE_ID=dev_example

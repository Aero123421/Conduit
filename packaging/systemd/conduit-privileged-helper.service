[Unit]
Description=Optional Conduit privileged helper
Documentation=https://github.com/Aero123421/Conduit
ConditionPathExists=/etc/conduit/privileged-helper.toml

[Service]
Type=exec
ExecStart=/usr/libexec/conduit/conduit-privileged-helper serve --config /etc/conduit/privileged-helper.toml
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

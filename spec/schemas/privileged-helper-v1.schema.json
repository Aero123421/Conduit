{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conduit.dev/spec/schemas/privileged-helper-v1.schema.json",
  "title": "Conduit privileged helper protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/PrivilegeTicket" },
    { "$ref": "#/$defs/LocalExecutionPlan" },
    { "$ref": "#/$defs/RootPolicy" },
    { "$ref": "#/$defs/SignedRootPolicy" },
    { "$ref": "#/$defs/SignedCapability" },
    { "$ref": "#/$defs/HelperReceipt" },
    { "$ref": "#/$defs/HelperRequest" },
    { "$ref": "#/$defs/HelperResponse" }
  ],
  "$defs": {
    "Id": { "type": "string", "pattern": "^[a-z][a-z0-9]*_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$" },
    "RunId": { "type": "string", "pattern": "^(run|lrun)_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$" },
    "RuntimeId": { "type": "string", "pattern": "^rt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$" },
    "Sha256Hex": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Base64Url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,4096}$" },
    "Timestamp": { "type": "string", "format": "date-time" },
    "Protocol": { "const": "conduit.privileged/1" },
    "ApprovalEnforcement": { "enum": ["exact_command", "adapter_mediated", "unavailable"] },
    "PrivilegedOperation": { "enum": ["prepare", "start", "inspect", "input", "resize_pty", "pause", "resume", "graceful_stop", "force_stop", "reconcile"] },
    "ResourceCeilings": {
      "type": "object", "additionalProperties": false,
      "required": ["cpuQuotaPerSecUsec", "memoryMaxBytes", "tasksMax", "ioWeight", "runtimeMaxUsec"],
      "properties": {
        "cpuQuotaPerSecUsec": { "type": ["integer", "null"], "minimum": 1000, "maximum": 1000000000 },
        "memoryMaxBytes": { "type": ["integer", "null"], "minimum": 1048576, "maximum": 281474976710656 },
        "tasksMax": { "type": ["integer", "null"], "minimum": 1, "maximum": 1048576 },
        "ioWeight": { "type": ["integer", "null"], "minimum": 1, "maximum": 10000 },
        "runtimeMaxUsec": { "type": ["integer", "null"], "minimum": 1000, "maximum": 604800000000 }
      }
    },
    "PrivilegeTicketClaims": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "protocol", "ticketId", "issuerKind", "issuerKeyId", "audience", "publicOrigin", "helperInstallationId", "helperKeyId", "helperPolicyRevision", "helperPolicyDigest", "deviceId", "deviceKeyId", "devicePolicyRevision", "expectedUid", "operationId", "idempotencyKeyDigest", "operationRequestDigest", "runManifestDigest", "runId", "runtimeId", "runtimeSpecDigest", "launchPlanDigest", "controlDigest", "localExecutionPlanDigest", "controllerEpoch", "connectorPolicyId", "connectorPolicyRevision", "projectId", "projectRevision", "assignmentId", "projectAgentId", "projectAgentRevision", "deviceRevision", "runtimeConfigurationRevision", "accessScope", "approvalMode", "approvalReceiptDigest", "approvalEnforcement", "requiredApprovalRiskClasses", "allowedOperation", "resourceCeilings", "issuedAt", "expiresAt", "nonce", "maxUseCount"],
      "properties": {
        "schemaVersion": { "const": 1 }, "protocol": { "$ref": "#/$defs/Protocol" }, "ticketId": { "$ref": "#/$defs/Id" },
        "issuerKind": { "const": "control_plane" }, "issuerKeyId": { "$ref": "#/$defs/Id" }, "audience": { "const": "conduit-privileged-helper" }, "publicOrigin": { "type": "string", "format": "uri", "maxLength": 512 },
        "helperInstallationId": { "$ref": "#/$defs/Id" }, "helperKeyId": { "$ref": "#/$defs/Id" },
        "helperPolicyRevision": { "type": "integer", "minimum": 1 }, "helperPolicyDigest": { "$ref": "#/$defs/Sha256Hex" },
        "deviceId": { "$ref": "#/$defs/Id" }, "deviceKeyId": { "$ref": "#/$defs/Id" }, "devicePolicyRevision": { "type": "integer", "minimum": 1 }, "expectedUid": { "type": "integer", "minimum": 1, "maximum": 4294967294 },
        "operationId": { "$ref": "#/$defs/Id" }, "idempotencyKeyDigest": { "$ref": "#/$defs/Sha256Hex" }, "operationRequestDigest": { "$ref": "#/$defs/Sha256Hex" }, "runManifestDigest": { "$ref": "#/$defs/Sha256Hex" },
        "runId": { "$ref": "#/$defs/RunId" }, "runtimeId": { "$ref": "#/$defs/RuntimeId" }, "runtimeSpecDigest": { "$ref": "#/$defs/Sha256Hex" }, "launchPlanDigest": { "$ref": "#/$defs/Sha256Hex" }, "controlDigest": { "anyOf": [{ "$ref": "#/$defs/Sha256Hex" }, { "type": "null" }] }, "localExecutionPlanDigest": { "$ref": "#/$defs/Sha256Hex" },
        "controllerEpoch": { "type": "integer", "minimum": 1 }, "connectorPolicyId": { "$ref": "#/$defs/Id" }, "connectorPolicyRevision": { "type": "integer", "minimum": 1 },
        "projectId": { "anyOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }] }, "projectRevision": { "type": ["integer", "null"], "minimum": 1 }, "assignmentId": { "anyOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }] },
        "projectAgentId": { "anyOf": [{ "$ref": "#/$defs/Id" }, { "type": "null" }] }, "projectAgentRevision": { "type": ["integer", "null"], "minimum": 1 }, "deviceRevision": { "type": "integer", "minimum": 1 }, "runtimeConfigurationRevision": { "type": "integer", "minimum": 1 },
        "accessScope": { "const": "full_device" }, "approvalMode": { "enum": ["always", "outside_scope", "risk_classes", "never"] }, "approvalReceiptDigest": { "anyOf": [{ "$ref": "#/$defs/Sha256Hex" }, { "type": "null" }] }, "approvalEnforcement": { "$ref": "#/$defs/ApprovalEnforcement" },
        "requiredApprovalRiskClasses": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" } },
        "allowedOperation": { "$ref": "#/$defs/PrivilegedOperation" }, "resourceCeilings": { "$ref": "#/$defs/ResourceCeilings" }, "issuedAt": { "$ref": "#/$defs/Timestamp" }, "expiresAt": { "$ref": "#/$defs/Timestamp" }, "nonce": { "$ref": "#/$defs/Base64Url" }, "maxUseCount": { "const": 1 }
      }
    },
    "PrivilegeTicket": {
      "type": "object", "additionalProperties": false, "required": ["keyId", "claims", "signature"],
      "properties": { "keyId": { "$ref": "#/$defs/Id" }, "claims": { "$ref": "#/$defs/PrivilegeTicketClaims" }, "signature": { "$ref": "#/$defs/Base64Url" } }
    },
    "FileIdentity": {
      "type": "object", "additionalProperties": false, "required": ["opaquePathId", "device", "inode", "mode", "uid", "size", "sha256"],
      "properties": { "opaquePathId": { "$ref": "#/$defs/Id" }, "device": { "type": "integer", "minimum": 0 }, "inode": { "type": "integer", "minimum": 1 }, "mode": { "type": "integer", "minimum": 0, "maximum": 65535 }, "uid": { "type": "integer", "minimum": 0, "maximum": 4294967294 }, "size": { "type": "integer", "minimum": 0, "maximum": 1073741824 }, "sha256": { "$ref": "#/$defs/Sha256Hex" } }
    },
    "WorkspaceBinding": {
      "type": "object", "additionalProperties": false, "required": ["locationId", "opaquePathId", "expectedIdentityDigest", "readOnly"],
      "properties": { "locationId": { "$ref": "#/$defs/Id" }, "opaquePathId": { "$ref": "#/$defs/Id" }, "expectedIdentityDigest": { "$ref": "#/$defs/Sha256Hex" }, "readOnly": { "type": "boolean" } }
    },
    "CredentialDescriptor": {
      "type": "object", "additionalProperties": false, "required": ["projectionId", "revision", "targetName", "descriptorIndex", "size", "sha256", "readOnly"],
      "properties": { "projectionId": { "$ref": "#/$defs/Id" }, "revision": { "type": "integer", "minimum": 1 }, "targetName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }, "descriptorIndex": { "type": "integer", "minimum": 0, "maximum": 31 }, "size": { "type": "integer", "minimum": 0, "maximum": 8388608 }, "sha256": { "$ref": "#/$defs/Sha256Hex" }, "readOnly": { "type": "boolean" } }
    },
    "LocalExecutionPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["planVersion", "runtimeId", "runId", "operationId", "executable", "interpreter", "argv", "cwd", "systemdUnit", "adapterId", "launchProfileId", "environment", "environmentValueDigests", "workspaces", "credentials", "stdio", "resources", "helperProtocol", "helperMinVersion"],
      "properties": {
        "planVersion": { "const": 1 }, "runtimeId": { "$ref": "#/$defs/RuntimeId" }, "runId": { "$ref": "#/$defs/RunId" }, "operationId": { "$ref": "#/$defs/Id" },
        "executable": { "$ref": "#/$defs/FileIdentity" }, "interpreter": { "anyOf": [{ "$ref": "#/$defs/FileIdentity" }, { "type": "null" }] },
        "argv": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "string", "maxLength": 32768 } }, "cwd": { "$ref": "#/$defs/FileIdentity" },
        "systemdUnit": { "type": "string", "pattern": "^conduit-elevated-rt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}\\.service$" }, "adapterId": { "type": ["string", "null"], "maxLength": 128 }, "launchProfileId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "environment": { "type": "object", "maxProperties": 128, "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]{0,127}$" }, "additionalProperties": { "type": "string", "maxLength": 32768 } },
        "environmentValueDigests": { "type": "object", "maxProperties": 128, "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]{0,127}$" }, "additionalProperties": { "$ref": "#/$defs/Sha256Hex" } },
        "workspaces": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/WorkspaceBinding" } }, "credentials": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/CredentialDescriptor" } },
        "stdio": { "enum": ["pipes", "pty"] }, "resources": { "$ref": "#/$defs/ResourceCeilings" }, "helperProtocol": { "$ref": "#/$defs/Protocol" }, "helperMinVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "RootPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["policyVersion", "installationId", "deviceId", "uid", "revision", "enabled", "origin", "ticketKeyIds", "allowedOperations", "allowedAdapters", "allowedLaunchProfiles", "launchProfileExecutableDigests", "allowedCredentialProfiles", "ceilings", "allowNever", "allowUnrestrictedLaunch", "allowPersistentSessions", "allowOfflineControl", "receiptRetentionSeconds"],
      "properties": {
        "policyVersion": { "const": 1 }, "installationId": { "$ref": "#/$defs/Id" }, "deviceId": { "$ref": "#/$defs/Id" }, "uid": { "type": "integer", "minimum": 1, "maximum": 4294967294 }, "revision": { "type": "integer", "minimum": 1 }, "enabled": { "type": "boolean" }, "origin": { "type": "string", "format": "uri", "maxLength": 512 },
        "ticketKeyIds": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } }, "allowedOperations": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/PrivilegedOperation" } },
        "allowedAdapters": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "maxLength": 128 } }, "allowedLaunchProfiles": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "maxLength": 128 } }, "launchProfileExecutableDigests": { "type": "object", "maxProperties": 32, "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" }, "additionalProperties": { "$ref": "#/$defs/Sha256Hex" } }, "allowedCredentialProfiles": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "maxLength": 128 } },
        "ceilings": { "$ref": "#/$defs/ResourceCeilings" }, "allowNever": { "type": "boolean" }, "allowUnrestrictedLaunch": { "type": "boolean" }, "allowPersistentSessions": { "type": "boolean" }, "allowOfflineControl": { "type": "boolean" }, "receiptRetentionSeconds": { "type": "integer", "minimum": 86400, "maximum": 31536000 }
      }
    },
    "SignedRootPolicy": { "type": "object", "additionalProperties": false, "required": ["keyId", "claims", "signature"], "properties": { "keyId": { "$ref": "#/$defs/Id" }, "claims": { "$ref": "#/$defs/RootPolicy" }, "signature": { "$ref": "#/$defs/Base64Url" } } },
    "CapabilityClaims": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "helperVersion", "installationId", "receiptKeyId", "policyRevision", "policyDigest", "enabled", "observedAt", "systemdSystemManager", "socketPeerCredentials", "transientUnits", "cgroupV2", "freeze", "pidfd", "openat2", "execveat", "pty", "streamReplay", "neverOptIn", "unrestrictedLaunchOptIn", "unavailableReason"],
      "properties": {
        "protocol": { "$ref": "#/$defs/Protocol" }, "helperVersion": { "type": "string", "maxLength": 64 }, "installationId": { "$ref": "#/$defs/Id" }, "receiptKeyId": { "$ref": "#/$defs/Id" }, "policyRevision": { "type": "integer", "minimum": 1 }, "policyDigest": { "$ref": "#/$defs/Sha256Hex" }, "enabled": { "type": "boolean" }, "observedAt": { "$ref": "#/$defs/Timestamp" },
        "systemdSystemManager": { "type": "boolean" }, "socketPeerCredentials": { "type": "boolean" }, "transientUnits": { "type": "boolean" }, "cgroupV2": { "type": "boolean" }, "freeze": { "type": "boolean" }, "pidfd": { "type": "boolean" }, "openat2": { "type": "boolean" }, "execveat": { "type": "boolean" }, "pty": { "type": "boolean" }, "streamReplay": { "type": "boolean" }, "neverOptIn": { "type": "boolean" }, "unrestrictedLaunchOptIn": { "type": "boolean" }, "unavailableReason": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "SignedCapability": { "type": "object", "additionalProperties": false, "required": ["keyId", "claims", "signature"], "properties": { "keyId": { "$ref": "#/$defs/Id" }, "claims": { "$ref": "#/$defs/CapabilityClaims" }, "signature": { "$ref": "#/$defs/Base64Url" } } },
    "ReceiptClaims": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "receiptId", "installationId", "receiptKeyId", "helperVersion", "policyRevision", "policyDigest", "ticketId", "ticketDigest", "operationId", "requestDigest", "runId", "runtimeId", "runtimeSpecDigest", "launchPlanDigest", "localExecutionPlanDigest", "controlRequestDigest", "controllerEpoch", "stateRevision", "transition", "unitName", "invocationId", "cgroup", "mainPid", "processBirth", "effectiveUid", "effectiveGid", "stdoutCursor", "stderrCursor", "exitCode", "signal", "observedAt", "previousReceiptDigest"],
      "properties": {
        "protocol": { "$ref": "#/$defs/Protocol" }, "receiptId": { "$ref": "#/$defs/Id" }, "installationId": { "$ref": "#/$defs/Id" }, "receiptKeyId": { "$ref": "#/$defs/Id" }, "helperVersion": { "type": "string", "maxLength": 64 }, "policyRevision": { "type": "integer", "minimum": 1 }, "policyDigest": { "$ref": "#/$defs/Sha256Hex" },
        "ticketId": { "$ref": "#/$defs/Id" }, "ticketDigest": { "$ref": "#/$defs/Sha256Hex" }, "operationId": { "$ref": "#/$defs/Id" }, "requestDigest": { "$ref": "#/$defs/Sha256Hex" }, "runId": { "$ref": "#/$defs/RunId" }, "runtimeId": { "$ref": "#/$defs/RuntimeId" }, "runtimeSpecDigest": { "$ref": "#/$defs/Sha256Hex" }, "launchPlanDigest": { "$ref": "#/$defs/Sha256Hex" }, "localExecutionPlanDigest": { "$ref": "#/$defs/Sha256Hex" }, "controlRequestDigest": { "anyOf": [{ "$ref": "#/$defs/Sha256Hex" }, { "type": "null" }] },
        "controllerEpoch": { "type": "integer", "minimum": 1 }, "stateRevision": { "type": "integer", "minimum": 1 }, "transition": { "enum": ["admitted", "prepared", "unit_created", "running", "paused", "resumed", "input_applied", "pty_resized", "stopping", "completed", "failed", "cancelled", "timed_out", "uncertain", "recovery_required"] }, "unitName": { "type": "string", "pattern": "^conduit-elevated-rt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}\\.service$" },
        "invocationId": { "type": ["string", "null"], "pattern": "^[a-f0-9]{32}$" }, "cgroup": { "type": ["string", "null"], "maxLength": 256 }, "mainPid": { "type": ["integer", "null"], "minimum": 1, "maximum": 4294967294 }, "processBirth": { "type": ["string", "null"], "maxLength": 128 }, "effectiveUid": { "type": ["integer", "null"], "minimum": 0, "maximum": 4294967294 }, "effectiveGid": { "type": ["integer", "null"], "minimum": 0, "maximum": 4294967294 }, "stdoutCursor": { "type": "integer", "minimum": 0 }, "stderrCursor": { "type": "integer", "minimum": 0 }, "exitCode": { "type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647 }, "signal": { "type": ["integer", "null"], "minimum": 1, "maximum": 64 }, "observedAt": { "$ref": "#/$defs/Timestamp" }, "previousReceiptDigest": { "anyOf": [{ "$ref": "#/$defs/Sha256Hex" }, { "type": "null" }] }
      }
    },
    "HelperReceipt": { "type": "object", "additionalProperties": false, "required": ["keyId", "claims", "signature"], "properties": { "keyId": { "$ref": "#/$defs/Id" }, "claims": { "$ref": "#/$defs/ReceiptClaims" }, "signature": { "$ref": "#/$defs/Base64Url" } } },
    "ChallengeClaims": {
      "type": "object", "additionalProperties": false, "required": ["protocol", "installationId", "deviceId", "uid", "pid", "pidStart", "nodeBootId", "clientNonce", "helperNonce", "issuedAt", "expiresAt"],
      "properties": { "protocol": { "$ref": "#/$defs/Protocol" }, "installationId": { "$ref": "#/$defs/Id" }, "deviceId": { "$ref": "#/$defs/Id" }, "uid": { "type": "integer", "minimum": 1 }, "pid": { "type": "integer", "minimum": 1 }, "pidStart": { "type": "string", "maxLength": 128 }, "nodeBootId": { "type": "string", "maxLength": 128 }, "clientNonce": { "$ref": "#/$defs/Base64Url" }, "helperNonce": { "$ref": "#/$defs/Base64Url" }, "issuedAt": { "$ref": "#/$defs/Timestamp" }, "expiresAt": { "$ref": "#/$defs/Timestamp" } }
    },
    "ControlTarget": {
      "type": "object", "additionalProperties": false, "required": ["runtimeId", "unitName", "invocationId", "controllerEpoch", "expectedStateRevision", "runtimeHandleDigest"],
      "properties": { "runtimeId": { "$ref": "#/$defs/RuntimeId" }, "unitName": { "type": "string", "maxLength": 192 }, "invocationId": { "type": "string", "pattern": "^[a-f0-9]{32}$" }, "controllerEpoch": { "type": "integer", "minimum": 1 }, "expectedStateRevision": { "type": "integer", "minimum": 1 }, "runtimeHandleDigest": { "$ref": "#/$defs/Sha256Hex" } }
    },
    "HelperRequest": {
      "type": "object", "additionalProperties": false, "required": ["kind", "payload"],
      "properties": { "kind": { "enum": ["hello", "prove", "probe", "prepare", "start", "inspect", "input", "resize_pty", "control", "reconcile"] }, "payload": { "type": "object", "maxProperties": 8 } }
    },
    "HelperResponse": {
      "type": "object", "additionalProperties": false, "required": ["kind", "payload"],
      "properties": { "kind": { "enum": ["challenge", "accepted", "capability", "receipt", "receipts", "error"] }, "payload": {} }
    }
  }
}
